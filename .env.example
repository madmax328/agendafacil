# =============================================================================
# DATABASE
# =============================================================================
# MongoDB Atlas connection string
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agendafacil?appName=agendafacil"

# =============================================================================
# NEXT AUTH
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# Z-API (WhatsApp Integration)
# =============================================================================
ZAPI_INSTANCE_ID="your-zapi-instance-id"
ZAPI_TOKEN="your-zapi-token"
ZAPI_WEBHOOK_SECRET="your-zapi-webhook-secret"

# =============================================================================
# STRIPE (Payments)
# =============================================================================
# Keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
STRIPE_STARTER_PRICE_ID="price_your-starter-price-id"
STRIPE_PRO_PRICE_ID="price_your-pro-price-id"

# =============================================================================
# RESEND (Transactional Email)
# =============================================================================
# Create at: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
