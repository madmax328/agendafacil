generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ProductionUnit {
  id                     String  @id @default(cuid()) @map("_id")
  type                   String  @unique
  name                   String
  password               String
  allowOrderModification Boolean @default(true)
}

model Cafeteria {
  id         String           @id @default(cuid()) @map("_id")
  name       String           @unique
  password   String
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  orders     Order[]
  amendments OrderAmendment[]
}

model Category {
  id       String    @id @default(cuid()) @map("_id")
  name     String
  unitType String
  active   Boolean   @default(true)
  products Product[]
}

model Product {
  id         String    @id @default(cuid()) @map("_id")
  name       String
  unit       String
  unitType   String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  orderItems     OrderItem[]
  amendmentItems OrderAmendmentItem[]
}

model Order {
  id           String      @id @default(cuid()) @map("_id")
  cafeteriaId  String
  cafeteria    Cafeteria   @relation(fields: [cafeteriaId], references: [id])
  deliveryDate DateTime
  status       OrderStatus @default(PENDING)
  notes        String?
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid()) @map("_id")
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  notes     String?
}

model OrderAmendment {
  id           String               @id @default(cuid()) @map("_id")
  type         String
  cafeteriaId  String
  cafeteria    Cafeteria            @relation(fields: [cafeteriaId], references: [id])
  deliveryDate DateTime
  status       String               @default("PENDING")
  items        OrderAmendmentItem[]
  createdAt    DateTime             @default(now())
}

model OrderAmendmentItem {
  id          String         @id @default(cuid()) @map("_id")
  amendmentId String
  amendment   OrderAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  quantity    Float
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
}
